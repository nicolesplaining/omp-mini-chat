+import type {
+	ExtensionCollabContext,
+	ExtensionCollabHostInfo,
+	ExtensionCollabStartOptions,
+} from "../extensibility/extensions/types";
+import type { InteractiveModeContext } from "../modes/types";
+import { CollabHost } from "./host";
+
+function hostInfo(host: CollabHost): ExtensionCollabHostInfo {
+	return {
+		link: host.link,
+		webLink: host.webLink,
+		viewLink: host.viewLink,
+		webViewLink: host.webViewLink,
+	};
+}
+
+/** Build the trusted-extension facade without exposing CollabHost internals. */
+export function createExtensionCollabContext(ctx: InteractiveModeContext): ExtensionCollabContext {
+	return {
+		isHosting: () => ctx.collabHost !== undefined,
+		info: () => (ctx.collabHost ? hostInfo(ctx.collabHost) : undefined),
+		start: async (options?: ExtensionCollabStartOptions) => {
+			if (ctx.collabGuest) throw new Error("Cannot host while joined to another collaboration session");
+			if (ctx.collabHost) return hostInfo(ctx.collabHost);
+
+			const relayInput = options?.relayUrl?.trim() || ctx.settings.get("collab.relayUrl") || "";
+			if (!relayInput) throw new Error("No collaboration relay is configured");
+			const relayUrl = relayInput.includes("://") ? relayInput : `wss://${relayInput}`;
+			const webUrl = options?.webUrl ?? ctx.settings.get("collab.webUrl") ?? "";
+			const host = new CollabHost(ctx);
+			await host.start(relayUrl, webUrl);
+			ctx.collabHost = host;
+			return hostInfo(host);
+		},
+		stop: async (reason = "host stopped by extension") => {
+			await ctx.collabHost?.stop(reason);
+		},
+	};
+}
